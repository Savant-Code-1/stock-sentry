# Environment & secrets (NEVER commit real credentials)
.env
.env.local
.streamlit/secrets.toml

# Local SQLite databases (auto-created on first run or in temp session dirs)
*.db
*.sqlite
*.sqlite3
database/*.db

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# IDE, OS & temporary files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
.pip_tmp/
