# Stock Sentry — Optional Environment Configuration
# Copy this file to `.env` if you want to customize defaults.
# The default application runs 100% locally WITHOUT any API key.
# NEVER commit a real `.env` file containing credentials to version control.

# Custom SQLite database path (optional)
# STOCK_SENTRY_DB_PATH=database/stock_sentry.db

# Upload security guardrails (optional)
MAX_UPLOAD_FILE_SIZE_MB=25.0
MAX_UPLOAD_ROWS=100000

# Dashboard pagination & cache TTL (optional)
TABLE_PAGE_SIZE=25
CACHE_TTL_SECONDS=300

# Baseline forecasting parameters (optional)
FORECAST_WINDOW_DAYS=14
DEFAULT_FORECAST_HORIZON_DAYS=7
DEFAULT_LEAD_TIME_DAYS=3
DEFAULT_SAFETY_STOCK_DAYS=2
EMA_ALPHA=0.35

# Anomaly detection thresholds (optional)
SALES_SPIKE_Z_THRESHOLD=2.2
SUDDEN_STOCK_DROP_PCT=0.35
LARGE_ADJUSTMENT_UNITS=15
LEDGER_MISMATCH_THRESHOLD=8

# Procurement budget limit in INR (optional)
DEFAULT_BUDGET_LIMIT=50000.0

# Optional future LLM integration (NOT required for default app)
LLM_PROVIDER=local_rule_based
LLM_API_KEY=
LLM_MODEL=
